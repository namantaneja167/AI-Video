  "cards": [
    {
      "dot": "cyan",
      "title": "Authoring",
      "items": [
        "Each edit is one SQLite transaction, acknowledged after commit",
        "episode.json is a projection for git, never the authority"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution",
      "items": [
        "Every job reads an immutable input snapshot",
        "Qwen is unloaded and confirmed gone before a render starts"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Outputs are keyed by input hash; a finished job never replaces the approved file",
        "Export copies the approved file, it never re-renders"
      ]
    }
  ]
