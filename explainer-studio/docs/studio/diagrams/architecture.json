    {
      "dot": "cyan",
      "title": "Authoring",
      "items": [
        "UI edits go to the server as small patches",
        "Every patch is journaled before it is acknowledged"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution",
      "items": [
        "The runner owns every long job",
        "TTS and render never overlap on this 16 GB machine"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "One schema validates edits, timing and render input",
